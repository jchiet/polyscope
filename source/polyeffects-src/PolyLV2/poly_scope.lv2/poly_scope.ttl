		lv2:minimum 0 ;
		lv2:maximum 4 ;
		lv2:name "Persistence" ;
		lv2:portProperty lv2:integer ,
			lv2:enumeration ;
		lv2:symbol "persistence"
	] , [
		a lv2:ControlPort ,
			lv2:InputPort ;
		lv2:index 8 ;
		lv2:default 2 ;
		lv2:minimum 0 ;
		lv2:maximum 4 ;
		lv2:name "Intensity" ;
