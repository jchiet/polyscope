@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsz: <http://lv2plug.in/ns/ext/resize-port#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<http://polyeffects.com/lv2/scope>
	a lv2:Plugin ,
		lv2:AnalyserPlugin ;
	doap:name "Poly Scope" ;
	doap:license <http://opensource.org/licenses/GPL-2.0> ;
	doap:description "Four channel Hector scope with direct audio/CV thru outputs and a batched waveform notify stream" ;
	doap:maintainer [
		foaf:name "Poly Effects" ;
	] ;
	lv2:symbol "scope" ;
	lv2:minorVersion 0 ;
	lv2:microVersion 1 ;
	rdfs:comment "Four channel scope for Hector with audio/CV thru routing, scalar meters, and a notify stream for the custom UI" ;
	lv2:requiredFeature urid:map ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:ControlPort ,
			lv2:InputPort ;
		lv2:index 0 ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:name "Freeze" ;
		lv2:portProperty lv2:toggled ;
		lv2:symbol "freeze"
	] , [
		a lv2:ControlPort ,
			lv2:InputPort ;
