		lv2:index 4 ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 2 ;
		lv2:name "Trigger Mode" ;
		lv2:portProperty lv2:integer ,
			lv2:enumeration ;
		lv2:symbol "trigger_mode"
	] , [
		a lv2:ControlPort ,
			lv2:InputPort ;
		lv2:index 5 ;
		lv2:default 0.0 ;
		lv2:minimum -1.0 ;
		lv2:maximum 1.0 ;
		lv2:name "Trigger Level" ;
		lv2:symbol "trigger_level"
