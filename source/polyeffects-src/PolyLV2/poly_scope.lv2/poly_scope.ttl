		lv2:symbol "out2"
	] , [
		a lv2:AudioPort ,
			lv2:OutputPort ;
		lv2:index 23 ;
		lv2:name "Thru 3" ;
		lv2:symbol "out3"
	] , [
		a lv2:AudioPort ,
			lv2:OutputPort ;
		lv2:index 24 ;
		lv2:name "Thru 4" ;
		lv2:symbol "out4"
	] , [
		a atom:AtomPort ,
			lv2:OutputPort ;
		atom:bufferType atom:Sequence ;
		atom:supports atom:String ;
		lv2:index 25 ;
		lv2:name "Notify" ;
		lv2:symbol "notify" ;
		rsz:minimumSize 4096 ;
		rdfs:comment "Batched waveform frames for the custom Poly Scope UI"
	] , [
		a lv2:ControlPort ,
			lv2:OutputPort ;
		lv2:index 26 ;
		lv2:default 0.0 ;
		lv2:minimum -10.0 ;
		lv2:maximum 10.0 ;
		lv2:name "Sample 1" ;
		lv2:symbol "sample_1"
	] , [
		a lv2:ControlPort ,
			lv2:OutputPort ;
		lv2:index 27 ;
		lv2:default 0.0 ;
		lv2:minimum -10.0 ;
		lv2:maximum 10.0 ;
		lv2:name "Sample 2" ;
		lv2:symbol "sample_2"
	] , [
		a lv2:ControlPort ,
			lv2:OutputPort ;
		lv2:index 28 ;
		lv2:default 0.0 ;
		lv2:minimum -10.0 ;
		lv2:maximum 10.0 ;
		lv2:name "Sample 3" ;
		lv2:symbol "sample_3"
	] , [
		a lv2:ControlPort ,
			lv2:OutputPort ;
		lv2:index 29 ;
		lv2:default 0.0 ;
		lv2:minimum -10.0 ;
		lv2:maximum 10.0 ;
		lv2:name "Sample 4" ;
		lv2:symbol "sample_4"
	] , [
		a lv2:ControlPort ,
			lv2:OutputPort ;
		lv2:index 30 ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 10.0 ;
		lv2:name "Peak 1" ;
		lv2:symbol "peak_1"
	] , [
		a lv2:ControlPort ,
			lv2:OutputPort ;
		lv2:index 31 ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 10.0 ;
