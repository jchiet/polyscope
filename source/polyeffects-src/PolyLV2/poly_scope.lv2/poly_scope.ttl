	] , [
		a lv2:ControlPort ,
			lv2:InputPort ;
		lv2:index 14 ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:name "Visible 2" ;
		lv2:portProperty lv2:toggled ;
		lv2:symbol "visible_2"
	] , [
		a lv2:ControlPort ,
			lv2:InputPort ;
		lv2:index 15 ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:name "Visible 3" ;
		lv2:portProperty lv2:toggled ;
		lv2:symbol "visible_3"
	] , [
